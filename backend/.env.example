PORT=5014
MONGO_URI=mongodb://127.0.0.1:27017/pargig
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=30d
OTP_TTL_SECONDS=300
PLATFORM_FEE_FLAT=10
PLATFORM_FEE_PERCENT=5
FREE_JOBS_AFTER_LAUNCH=3
WALLET_DEPOSIT_AMOUNT=20
FIRST_JOB_FREE_BELOW=1000

# --- Road-distance routing (utils/routing.js) ---
# Nearby Workers distances come from the OSRM Table API (free,
# no key). When OSRM is unreachable, the backend falls back to a
# haversine × 1.35 estimate so the mobile card still has a
# road-realistic number to render.
# Override the OSRM host if you self-host — the default public
# endpoint is router.project-osrm.org which can be slow/rate-limited.
OSRM_BASE_URL=

# --- S3 uploads (middleware/uploadMiddleware.js) ---
# Job photos, voice notes, profile photos and KYC documents go to S3 when
# ALL FOUR of the variables below are set. Leave them blank and uploads
# fall back to the local ./uploads folder (fine for development, but on a
# single EC2 box those files die with the instance).
#
# The IAM user needs only s3:PutObject on arn:aws:s3:::YOUR_BUCKET/uploads/*
# — do not give it broader access than that.
#
# NEVER commit real keys. This file is a template; .env itself is gitignored.
AWS_S3_BUCKET=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional. Serve objects through CloudFront or a custom domain instead of
# the default https://BUCKET.s3.REGION.amazonaws.com. The URL is saved onto
# each document at upload time, so changing this later does NOT rewrite
# rows already written.
AWS_S3_PUBLIC_BASE=

# Optional, usually leave blank. Buckets created since April 2023 default to
# "Bucket owner enforced", which REJECTS object ACLs — setting this to
# public-read there fails every upload with AccessControlListNotSupported.
# Grant public read with a bucket policy instead.
AWS_S3_ACL=
