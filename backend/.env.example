PORT=5014
MONGO_URI=mongodb://127.0.0.1:27017/pargig
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=30d
OTP_TTL_SECONDS=300

# --- Login OTP over SMS: MSG91 (utils/sms.js) ---
# Leave MSG91_AUTH_KEY blank and no SMS is sent: the code comes back in
# the /auth/otp/request response as `devOtp` instead, which is how local
# development works. Fill both required values in and that stops — the
# code only ever reaches the handset.
#
# Both are required before anything is sent. See MSG91_SETUP.md for
# where each one comes from.
#
# NEVER commit real keys. This file is a template; .env itself is gitignored.
MSG91_AUTH_KEY=
# The DLT-approved OTP template registered in the MSG91 dashboard.
MSG91_TEMPLATE_ID=
# Optional. The 6-character header the SMS arrives from, e.g. PARGIG.
# Usually fixed by the template, in which case leave this blank.
MSG91_SENDER_ID=
# Optional. Country code prefixed to the 10-digit numbers we store.
MSG91_COUNTRY_CODE=91

# --- OTP rate limits (utils/otpThrottle.js) ---
# Every code now costs a message, so /auth/otp/request is capped. The
# per-mobile numbers live on the user record; the per-IP one is in
# memory and is skipped when the proxy isn't forwarding a real client
# address (see app.js 'trust proxy').
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_PER_DAY=10
OTP_MAX_PER_IP_PER_HOUR=20
PLATFORM_FEE_FLAT=10
PLATFORM_FEE_PERCENT=5
FREE_JOBS_AFTER_LAUNCH=3
WALLET_DEPOSIT_AMOUNT=20
FIRST_JOB_FREE_BELOW=1000

# --- Road-distance routing (utils/routing.js) ---
# Nearby Workers distances come from the OSRM Table API (free,
# no key). When OSRM is unreachable, the backend falls back to a
# haversine × 1.35 estimate so the mobile card still has a
# road-realistic number to render.
# Override the OSRM host if you self-host — the default public
# endpoint is router.project-osrm.org which can be slow/rate-limited.
OSRM_BASE_URL=

# --- S3 uploads (middleware/uploadMiddleware.js) ---
# Job photos, voice notes, profile photos and KYC documents go to S3 when
# ALL FOUR of the variables below are set. Leave them blank and uploads
# fall back to the local ./uploads folder (fine for development, but on a
# single EC2 box those files die with the instance).
#
# The IAM user needs only s3:PutObject on arn:aws:s3:::YOUR_BUCKET/uploads/*
# — do not give it broader access than that.
#
# NEVER commit real keys. This file is a template; .env itself is gitignored.
AWS_S3_BUCKET=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional. Serve objects through CloudFront or a custom domain instead of
# the default https://BUCKET.s3.REGION.amazonaws.com. The URL is saved onto
# each document at upload time, so changing this later does NOT rewrite
# rows already written.
AWS_S3_PUBLIC_BASE=

# Optional, usually leave blank. Buckets created since April 2023 default to
# "Bucket owner enforced", which REJECTS object ACLs — setting this to
# public-read there fails every upload with AccessControlListNotSupported.
# Grant public read with a bucket policy instead.
AWS_S3_ACL=

# ---------------------------------------------------------------- SMTP
# Outbound email. Today its only job is the admin forgot-password code
# (POST /api/auth/admin/forgot-password).
#
# SMTP_HOST and MAIL_FROM are the minimum. Without both, nothing is
# sent: on a dev box the code comes back in the API response instead,
# and in production the reset silently does nothing — which is the one
# failure nobody notices until an admin is already locked out.
#
# SMTP_PORT: 587 opens plain and upgrades with STARTTLS; 465 is TLS from
# the first byte. The mode is picked from the port, so the wrong one
# makes the connection hang rather than fail.
#
# MAIL_FROM must be an address the provider has verified, or the message
# is rejected or filed as spam. Format: Pargig <no-reply@pargig.in>
#
# Gmail wants a 16-character App Password, not the account password.
# Amazon SES issues SMTP credentials that are NOT the AWS keys above,
# and only sends to verified addresses until you leave its sandbox.
#
# Verify before trusting it:  npm run mail:test you@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# --- Public address, for URLs this server hands out ---
# Normally left blank: the webhook URL shown in Settings is built from
# whatever address the panel was opened on, which is why moving from
# an IP to a domain needs no code change.
#
# Set it during the window where both an IP and a domain reach this
# server. Opening the panel on the IP would otherwise hand you an IP
# webhook URL to paste into Razorpay — which works until the IP
# changes, and then fails quietly, because a webhook nobody calls
# looks exactly like one that was never needed.
#
# No trailing slash.
#   PUBLIC_ORIGIN=https://pargig.in
PUBLIC_ORIGIN=
