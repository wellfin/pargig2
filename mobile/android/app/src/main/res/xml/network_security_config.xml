<?xml version="1.0" encoding="utf-8"?>
<!--
  Allow plain HTTP to the production EC2 IP (no HTTPS yet) and to common
  dev/local addresses. Once you set up a real domain + Let's Encrypt
  (DEPLOY.md §12) and switch the app to https://api.example.com, you can
  remove the cleartext entries below — HTTPS works by default with no config.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Production EC2 backend (replace with your domain after §12) -->
        <domain includeSubdomains="false">52.66.245.202</domain>

        <!-- Dev: Android emulator loopback -->
        <domain includeSubdomains="false">10.0.2.2</domain>

        <!-- Dev: iOS simulator / desktop loopback -->
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
